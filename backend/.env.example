# Copy thành .env:  cp .env.example .env   — KHÔNG commit .env
APP_NAME=xlearn-backend
ENVIRONMENT=development

# Cổng HTTP. Trên Railway/Render/Cloud Run, platform tự set biến PORT.
PORT=8000

# Khóa API bảo vệ endpoint /ask. BẮT BUỘC — app không chạy nếu thiếu.
AGENT_API_KEY=doi-thanh-khoa-cua-ban

# Khóa ký JWT, BẮT BUỘC, tối thiểu 32 ký tự. Sinh khóa mới:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=doi-thanh-chuoi-ngau-nhien-it-nhat-32-ky-tu
# ACCESS_TOKEN_EXPIRE_MINUTES=15
# REFRESH_TOKEN_EXPIRE_DAYS=7

# Redis dùng để lưu state (lịch sử hội thoại, rate limit, chi phí).
#   redis://localhost:6379/0   → chạy app trực tiếp trên máy, Redis bằng Docker
#   fake://                    → Redis giả trong RAM, dùng khi chưa cài Docker
# (docker-compose tự ghi đè thành redis://redis:6379/0)
REDIS_URL=redis://localhost:6379/0

# PostgreSQL (docker-compose dùng các biến này để tạo DB, mặc định đều là "xlearn")
POSTGRES_DB=xlearn
POSTGRES_USER=xlearn
POSTGRES_PASSWORD=doi-mat-khau-db
# Cổng Postgres trên máy host (đổi nếu máy đã có Postgres chạy ở 5432)
POSTGRES_PORT=5432
#   localhost  → chạy app trực tiếp trên máy, Postgres bằng Docker
# (docker-compose tự ghi đè hostname thành postgres)
DATABASE_URL=postgresql://xlearn:doi-mat-khau-db@localhost:5432/xlearn

# TTL (giây) cho key state trong Redis — mặc định 7 ngày
STATE_TTL_SECONDS=604800

# Gốc URL công khai của object storage; URL file = <MEDIA_BASE_URL>/<bucket>/<object_key>
# Bỏ trống → video/PDF của bài học hiện "chưa được tải lên"
# MEDIA_BASE_URL=http://localhost:9000

# Object storage chuẩn S3: có S3_BUCKET thì bật upload file (video, PDF, ảnh, tài liệu đính kèm).
# Bucket để private; file được xem qua URL tạm thời (presigned). Mặc định dưới đây khớp storage
# trong docker-compose (SeaweedFS). Đổi sang Supabase Storage / AWS S3 chỉ cần sửa các biến này.
S3_BUCKET=xlearn-media
# Ghi vào storage_objects.provider: s3 | minio | gcs | azure (SeaweedFS / Supabase: s3)
S3_PROVIDER=s3
#   localhost:8333 → chạy app trực tiếp trên máy (docker-compose tự ghi đè thành http://seaweedfs:8333)
S3_ENDPOINT_URL=http://localhost:8333
# Địa chỉ trình duyệt dùng để tải file lên/xem file
S3_PUBLIC_URL=http://localhost:8333
S3_REGION=us-east-1
# docker-compose cũng dùng cặp khóa này để cấu hình SeaweedFS
S3_ACCESS_KEY=xlearn
S3_SECRET_KEY=doi-khoa-bi-mat-storage
# Giới hạn mỗi file (MB). Mặc định 512000 = 500 GB, mức tối đa của Supabase gói Pro.
# Supabase gói Free chặn 50 MB/file → đặt MAX_UPLOAD_MB=50 nếu dùng gói Free.
# MAX_UPLOAD_MB=512000
# Kích thước mỗi phần khi upload nhiều phần (MB, tối thiểu 5)
# S3_PART_SIZE_MB=16

# Origin frontend được phép gọi API, cách nhau bởi dấu phẩy
CORS_ORIGINS=http://localhost:5173

# Giới hạn số request mỗi phút cho mỗi user
# RATE_LIMIT_PER_MINUTE=10

# Ngân sách tối đa mỗi user mỗi tháng (USD)
# MONTHLY_BUDGET_USD=10.0

# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
