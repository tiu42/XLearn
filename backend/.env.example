# Copy thành .env:  cp .env.example .env   — KHÔNG commit .env
APP_NAME=xlearn-backend
ENVIRONMENT=development

# Cổng HTTP. Trên Railway/Render/Cloud Run, platform tự set biến PORT.
PORT=8000

# Khóa API bảo vệ endpoint /ask. BẮT BUỘC — app không chạy nếu thiếu.
AGENT_API_KEY=doi-thanh-khoa-cua-ban

# Khóa ký JWT, BẮT BUỘC, tối thiểu 32 ký tự. Sinh khóa mới:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=doi-thanh-chuoi-ngau-nhien-it-nhat-32-ky-tu
# ACCESS_TOKEN_EXPIRE_MINUTES=15
# REFRESH_TOKEN_EXPIRE_DAYS=7

# Redis dùng để lưu state (lịch sử hội thoại, rate limit, chi phí).
#   redis://localhost:6379/0   → chạy app trực tiếp trên máy, Redis bằng Docker
#   fake://                    → Redis giả trong RAM, dùng khi chưa cài Docker
# (docker-compose tự ghi đè thành redis://redis:6379/0)
REDIS_URL=redis://localhost:6379/0

# PostgreSQL (docker-compose dùng các biến này để tạo DB, mặc định đều là "xlearn")
POSTGRES_DB=xlearn
POSTGRES_USER=xlearn
POSTGRES_PASSWORD=doi-mat-khau-db
# Cổng Postgres trên máy host (đổi nếu máy đã có Postgres chạy ở 5432)
POSTGRES_PORT=5432
#   localhost  → chạy app trực tiếp trên máy, Postgres bằng Docker
# (docker-compose tự ghi đè hostname thành postgres)
DATABASE_URL=postgresql://xlearn:doi-mat-khau-db@localhost:5432/xlearn

# TTL (giây) cho key state trong Redis — mặc định 7 ngày
STATE_TTL_SECONDS=604800

# Origin frontend được phép gọi API, cách nhau bởi dấu phẩy
CORS_ORIGINS=http://localhost:5173

# Giới hạn số request mỗi phút cho mỗi user
# RATE_LIMIT_PER_MINUTE=10

# Ngân sách tối đa mỗi user mỗi tháng (USD)
# MONTHLY_BUDGET_USD=10.0

# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
